{
  "name": "together-listen",
  "version": "0.1.0",
  "private": true,
  "description": "Simple synchronized listening room over WebSocket",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node tests/run-all.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop together-listen",
    "pm2:restart": "pm2 restart together-listen",
    "pm2:logs": "pm2 logs together-listen",
    "android:open": "echo '请用 Android Studio 打开 android/ 目录'",
    "android:build": "cd android && ./gradlew assembleDebug"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.21.0",
    "NeteaseCloudMusicApi": "^4.31.0",
    "socket.io": "^4.8.0"
  },
  "devDependencies": {
    "pm2": "^5.4.3",
    "socket.io-client": "^4.8.0"
  }
}
