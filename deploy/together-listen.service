# systemd 示例：复制到 /etc/systemd/system/together-listen.service 后按需改路径与用户
#
#   sudo cp deploy/together-listen.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now together-listen
#
# 查看日志：journalctl -u together-listen -f

[Unit]
Description=Together Listen (sync music rooms)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 改成你的系统用户与项目绝对路径
User=ubuntu
WorkingDirectory=/home/ubuntu/.hermes/together-listen
ExecStart=/usr/bin/node server.js
Environment=NODE_ENV=production
Environment=PORT=3847
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
